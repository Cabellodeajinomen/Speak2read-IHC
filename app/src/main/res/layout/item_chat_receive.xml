<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="8dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="64dp">

    <TextView
        android:id="@+id/tvMessageReceive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="320dp"
        android:background="@drawable/bg_chat_receive"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/s2r_text_primary"
        android:textIsSelectable="true"
        android:textSize="16sp"
        android:elevation="1dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTimeReceive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8:00 PM"
            android:textSize="11sp"
            android:textColor="@color/s2r_text_secondary"
            android:alpha="0.6"
            android:layout_marginStart="4dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/btnSpeakReceive"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/speak_message"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            app:tint="@color/s2r_text_secondary"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:alpha="0.6"/>

        <ImageButton
            android:id="@+id/btnExpandReceive"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/expand_message"
            android:src="@android:drawable/ic_menu_zoom"
            app:tint="@color/s2r_text_secondary"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:alpha="0.6"/>

        <ImageButton
            android:id="@+id/btnFavoriteReceive"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_favorites"
            android:src="@android:drawable/btn_star_big_off"
            app:tint="@color/s2r_text_secondary"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:alpha="0.6"/>
    </LinearLayout>
</LinearLayout>
