<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/s2r_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Logo Circular Profesional -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="60dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/s2r_accent"
        app:strokeWidth="2dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_speak2read"
            android:contentDescription="@string/login_logo_desc"
            android:padding="8dp" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/s2r_text_primary"
        android:textSize="32sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="@string/slogan_login"
        android:textColor="@color/s2r_text_secondary"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etUsername"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_input_container"
        android:hint="@string/login_username_hint"
        android:inputType="text"
        android:paddingHorizontal="20dp"
        android:textColor="@color/s2r_text_primary"
        android:textColorHint="@color/s2r_text_secondary" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_container"
        android:hint="@string/login_password_hint"
        android:inputType="textPassword"
        android:paddingHorizontal="20dp"
        android:textColor="@color/s2r_text_primary"
        android:textColorHint="@color/s2r_text_secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="@string/login_btn_entrar"
        app:cornerRadius="28dp"
        android:backgroundTint="@color/s2r_bubble_usuario"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

    <com.google.android.gms.common.SignInButton
        android:id="@+id/btnGoogleLogin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegister"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/login_btn_register"
        android:textColor="@color/s2r_accent" />

</LinearLayout>
