<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/s2r_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/s2r_background"
            android:contentInsetStart="16dp"
            android:contentInsetEnd="12dp"
            android:title="@string/home_title"
            android:titleTextColor="@color/s2r_text_primary">

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:background="@android:color/transparent"
                android:contentDescription="@string/settings"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_manage"
                android:tint="@color/s2r_text_primary" />
        </Toolbar>

        <!-- Categories -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <Button
                    android:id="@+id/btnHospital"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏥 Hospital"
                    android:textAllCaps="false"/>

                <Button
                    android:id="@+id/btnTransporte"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚌 Transporte"
                    android:textAllCaps="false"/>

                <Button
                    android:id="@+id/btnCompras"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛒 Compras"
                    android:textAllCaps="false"/>

                <Button
                    android:id="@+id/btnEmergencia"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚨 Emergencia"
                    android:textAllCaps="false"/>

                <Button
                    android:id="@+id/btnPersonalizado"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ Personalizado"
                    android:textAllCaps="false"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- INTERLOCUTOR Area -->
        <LinearLayout
            android:id="@+id/transcriptionContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3.5"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INTERLOCUTOR"
                android:textColor="@color/s2r_text_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:alpha="0.7"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_container"
                android:padding="12dp">

                <EditText
                    android:id="@+id/etTranscription"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="@string/interlocutor_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:gravity="top"
                    android:textColor="@color/s2r_text_primary"
                    android:textColorHint="@color/s2r_text_primary"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnMicTranscription"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/microfono"
                        android:src="@android:drawable/ic_btn_speak_now"
                        android:tint="@color/s2r_text_primary" />

                    <ImageButton
                        android:id="@+id/btnFullscreenTranscription"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/fullscreen_transcription"
                        android:src="@android:drawable/ic_menu_view"
                        android:tint="@color/s2r_text_primary" />

                    <ImageButton
                        android:id="@+id/btnSendTranscription"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/send_message"
                        android:src="@android:drawable/ic_menu_send"
                        android:tint="@color/s2r_text_primary" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Conversation History -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3.5"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HISTORIAL"
                android:textColor="@color/s2r_text_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:alpha="0.7"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerChat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingVertical="8dp"
                tools:listitem="@android:layout/simple_list_item_1" />
        </LinearLayout>

        <!-- My Response & Quick Replies -->
        <LinearLayout
            android:id="@+id/bottomArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="12dp"
            android:background="@color/s2r_background"
            android:elevation="8dp">

            <HorizontalScrollView
                android:id="@+id/quickReplyScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/quickReplyContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/qr_si"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="6dp"
                        app:cardBackgroundColor="@color/s2r_surface"
                        app:cardCornerRadius="24dp"
                        app:strokeColor="#3B82F6"
                        app:strokeWidth="2dp">
                        <TextView
                            android:id="@+id/tvQr1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="14dp"
                            android:text="Sí"
                            android:textColor="@color/s2r_text_primary"
                            android:textSize="16sp"
                            android:gravity="center" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/qr_no"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="6dp"
                        app:cardBackgroundColor="@color/s2r_surface"
                        app:cardCornerRadius="24dp"
                        app:strokeColor="#3B82F6"
                        app:strokeWidth="2dp">
                        <TextView
                            android:id="@+id/tvQr2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="14dp"
                            android:text="No"
                            android:textColor="@color/s2r_text_primary"
                            android:textSize="16sp"
                            android:gravity="center" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/qr_repite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="6dp"
                        app:cardBackgroundColor="@color/s2r_surface"
                        app:cardCornerRadius="24dp"
                        app:strokeColor="#3B82F6"
                        app:strokeWidth="2dp">
                        <TextView
                            android:id="@+id/tvQr3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="14dp"
                            android:text="Repite"
                            android:textColor="@color/s2r_text_primary"
                            android:textSize="16sp"
                            android:gravity="center" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/qr_ayuda"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="6dp"
                        app:cardBackgroundColor="@color/s2r_surface"
                        app:cardCornerRadius="24dp"
                        app:strokeColor="#3B82F6"
                        app:strokeWidth="2dp">
                        <TextView
                            android:id="@+id/tvQr4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="14dp"
                            android:text="Ayuda"
                            android:textColor="@color/s2r_text_primary"
                            android:textSize="16sp"
                            android:gravity="center" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/inputArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_container"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="6dp">

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/user_message_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:maxLines="3"
                    android:minHeight="48dp"
                    android:paddingHorizontal="8dp"
                    android:textColor="@color/s2r_text_primary"
                    android:textColorHint="@color/s2r_text_primary"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/btnSpeaker"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/altavoz"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    android:tint="@color/s2r_text_primary" />

                <ImageButton
                    android:id="@+id/btnSendMessage"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/send_message"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_send"
                    android:tint="@color/s2r_text_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Emergency Overlay -->
    <LinearLayout
        android:id="@+id/emergencyOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CCFF0000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgWarning"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@string/emergency_detected"
            android:src="@android:drawable/stat_sys_warning"
            android:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/emergency_detected"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAcknowledge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/dialog_accept" />
    </LinearLayout>

</FrameLayout>
