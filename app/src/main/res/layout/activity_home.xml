<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/s2r_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/s2r_background"
            android:contentInsetStart="16dp"
            android:contentInsetEnd="12dp"
            android:title="@string/home_title"
            android:titleTextColor="@color/s2r_text_primary">

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="@color/s2r_text_primary" />
        </Toolbar>

        <!-- Categories -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingVertical="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHospital"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="🏥 Hospital"
                    android:textAllCaps="false"
                    android:textColor="@color/s2r_text_primary"
                    android:paddingHorizontal="16dp"
                    app:rippleColor="#33FFFFFF"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTransporte"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="🚌 Transporte"
                    android:textAllCaps="false"
                    android:textColor="@color/s2r_text_primary"
                    android:paddingHorizontal="16dp"
                    app:rippleColor="#33FFFFFF"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCompras"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="🛒 Compras"
                    android:textAllCaps="false"
                    android:textColor="@color/s2r_text_primary"
                    android:paddingHorizontal="16dp"
                    app:rippleColor="#33FFFFFF"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmergencia"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="🚨 Emergencia"
                    android:textAllCaps="false"
                    android:textColor="@color/s2r_text_primary"
                    android:paddingHorizontal="16dp"
                    app:rippleColor="#33FFFFFF"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPersonalizado"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="⭐ Personalizado"
                    android:textAllCaps="false"
                    android:textColor="@color/s2r_text_primary"
                    android:paddingHorizontal="16dp"
                    app:rippleColor="#33FFFFFF"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- INTERLOCUTOR Area -->
        <LinearLayout
            android:id="@+id/transcriptionContainer"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_interlocutor"
                android:textColor="@color/s2r_text_primary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:alpha="0.7"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_container"
                android:padding="10dp">

                <EditText
                    android:id="@+id/etTranscription"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="@string/interlocutor_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:gravity="top"
                    android:textColor="@color/s2r_text_primary"
                    android:textColorHint="@color/s2r_text_secondary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnMicTranscription"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/microfono"
                        android:src="@android:drawable/ic_btn_speak_now"
                        app:tint="@color/s2r_text_primary" />

                    <ImageButton
                        android:id="@+id/btnFullscreenTranscription"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/fullscreen_transcription"
                        android:src="@android:drawable/ic_menu_view"
                        app:tint="@color/s2r_text_primary" />

                    <ImageButton
                        android:id="@+id/btnSendTranscription"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/send_message"
                        android:src="@android:drawable/ic_menu_send"
                        app:tint="@color/s2r_text_primary" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Conversation History -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_historial"
                android:textColor="@color/s2r_text_primary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:alpha="0.7"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerChat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingVertical="8dp"
                tools:listitem="@android:layout/simple_list_item_1" />
        </LinearLayout>

        <!-- My Response & Quick Replies -->
        <LinearLayout
            android:id="@+id/bottomArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp"
            android:background="@color/s2r_background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_mi_respuesta"
                android:textColor="@color/s2r_text_primary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:alpha="0.7"/>

            <androidx.gridlayout.widget.GridLayout
                android:id="@+id/quickReplyGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:columnCount="2"
                app:alignmentMode="alignMargins">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/qr_si"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/s2r_surface"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/s2r_accent"
                    app:strokeWidth="1dp">
                    <TextView
                        android:id="@+id/tvQr1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="Sí"
                        android:textColor="@color/s2r_text_primary"
                        android:textSize="14sp"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/qr_no"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/s2r_surface"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/s2r_accent"
                    app:strokeWidth="1dp">
                    <TextView
                        android:id="@+id/tvQr2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="No"
                        android:textColor="@color/s2r_text_primary"
                        android:textSize="14sp"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/qr_repite"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/s2r_surface"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/s2r_accent"
                    app:strokeWidth="1dp">
                    <TextView
                        android:id="@+id/tvQr3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="Repite"
                        android:textColor="@color/s2r_text_primary"
                        android:textSize="14sp"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/qr_ayuda"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/s2r_surface"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/s2r_accent"
                    app:strokeWidth="1dp">
                    <TextView
                        android:id="@+id/tvQr4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="Ayuda"
                        android:textColor="@color/s2r_text_primary"
                        android:textSize="14sp"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>
            </androidx.gridlayout.widget.GridLayout>

            <LinearLayout
                android:id="@+id/inputArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_container"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="6dp">

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/user_message_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:maxLines="3"
                    android:minHeight="48dp"
                    android:paddingHorizontal="8dp"
                    android:textColor="@color/s2r_text_primary"
                    android:textColorHint="@color/s2r_text_secondary"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/btnSpeaker"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/altavoz"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    app:tint="@color/s2r_text_primary" />

                <ImageButton
                    android:id="@+id/btnSendMessage"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/send_message"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_send"
                    app:tint="@color/s2r_text_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Floating Action Button for Emergency Help -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabEmergencyHelp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/fab_ayuda"
        app:backgroundTint="@color/s2r_alert"
        app:srcCompat="@android:drawable/ic_dialog_alert"
        app:tint="@android:color/white" />

    <!-- Emergency Overlay -->
    <LinearLayout
        android:id="@+id/emergencyOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CCFF0000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgWarning"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@string/emergency_detected"
            android:src="@android:drawable/stat_sys_warning"
            android:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/emergency_detected"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAcknowledge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/dialog_accept" />
    </LinearLayout>

</FrameLayout>
