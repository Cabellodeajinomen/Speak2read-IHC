<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/s2r_background">

    <!-- HEADER SOS -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sosHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:cardBackgroundColor="@color/s2r_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/logo_final_v5" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Speak2Read"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/s2r_text_primary" />

            <ImageButton
                android:id="@+id/btnSosHeader"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_dialog_alert"
                app:tint="@color/s2r_alert"
                android:contentDescription="Botón de pánico" />

            <ImageButton
                android:id="@+id/btnSelectContact"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_my_calendar"
                app:tint="@color/s2r_text_secondary"
                android:layout_marginStart="8dp" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_preferences"
                app:tint="@color/s2r_text_secondary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ZONA DEL INTERLOCUTOR (LO QUE ESCUCHO) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTranscription"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/s2r_bubble_interlocutor"
        app:layout_constraintTop_toBottomOf="@id/sosHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_btn_speak_now"
                    app:tint="@color/s2r_text_secondary"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" LO QUE ÉL/ELLA DICE (Escuchando...)"
                    android:textAllCaps="true"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/s2r_text_secondary" />
            </LinearLayout>

            <EditText
                android:id="@+id/etTranscription"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="top"
                android:hint="Aquí aparecerá lo que la otra persona hable..."
                android:textColor="@color/s2r_text_primary"
                android:textSize="20sp"
                android:focusable="false"
                android:longClickable="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnMicTranscription"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_quick_reply_card"
                    android:src="@android:drawable/ic_btn_speak_now"
                    app:tint="@color/s2r_bubble_usuario" />

                <ImageButton
                    android:id="@+id/btnFullscreenTranscription"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_quick_reply_card"
                    android:src="@android:drawable/ic_menu_zoom"
                    app:tint="@color/s2r_text_secondary" />

                <ImageButton
                    android:id="@+id/btnSendTranscription"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_quick_reply_card"
                    android:src="@android:drawable/ic_menu_send"
                    app:tint="@color/s2r_text_primary" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- CHAT HISTORY -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/cardTranscription"
        app:layout_bottom_toTopOf="@id/cardInput" />

    <!-- ZONA DEL SORDO (LO QUE YO DIGO) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/s2r_bubble_usuario"
        app:layout_bottom_toTopOf="@id/bottom_navigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="YO DIGO (Escribe aquí abajo):"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/s2r_bubble_usuario" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnSpeaker"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    app:tint="@color/s2r_bubble_usuario" />

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Toca para escribir..."
                    android:padding="12dp"
                    android:textColor="@color/s2r_text_primary"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/btnSendMessage"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_quick_reply_card"
                    android:backgroundTint="@color/s2r_bubble_usuario"
                    android:src="@android:drawable/ic_menu_send"
                    app:tint="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_bottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu"
        android:background="@color/s2r_surface" />

    <!-- OVERLAY EMERGENCIA -->
    <FrameLayout
        android:id="@+id/emergencyOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6D32F2F"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/imgWarning"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@android:drawable/ic_dialog_alert"
                app:tint="@color/white" />
            <TextView
                android:id="@+id/tvEmergencyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡ALERTA!"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvEmergencyType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sonido de Peligro"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:gravity="center"
                android:layout_marginTop="8dp" />
            <Button
                android:id="@+id/btnAcknowledge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:paddingHorizontal="32dp"
                android:backgroundTint="@color/white"
                android:text="ENTENDIDO"
                android:textColor="@color/s2r_alert" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
