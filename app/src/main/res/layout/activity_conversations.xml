<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/s2r_background">

    <!-- HEADER IGUAL AL HOME -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sosHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:cardBackgroundColor="@color/s2r_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/logo_final_v5"
                android:contentDescription="Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Mis Chats"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/s2r_text_primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- LISTA DE CONVERSACIONES -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvContactsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/sosHeader"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        tools:listitem="@android:layout/simple_list_item_2" />

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aún no tienes chats guardados"
        android:textColor="@color/s2r_text_secondary"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu"
        android:background="@color/s2r_surface" />

</androidx.constraintlayout.widget.ConstraintLayout>
