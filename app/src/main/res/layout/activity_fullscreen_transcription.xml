<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/s2r_background">

    <ImageButton
        android:id="@+id/btnCloseFullscreen"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="@color/s2r_text_secondary"
        android:contentDescription="@string/btn_close" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/btnCloseFullscreen"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvFullscreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/s2r_text_primary"
                android:textSize="36sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
