<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp">

    <TextView
        android:id="@+id/tvMessageSend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        android:background="@drawable/bg_chat_send"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="@color/s2r_text_primary"
        android:textIsSelectable="true"
        android:textSize="16sp"
        android:gravity="end" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <ImageButton
            android:id="@+id/btnSpeakSend"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/speak_message"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            app:tint="@color/s2r_text_secondary"
            android:padding="6dp"
            android:scaleType="fitCenter"/>

        <ImageButton
            android:id="@+id/btnExpandSend"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/expand_message"
            android:src="@android:drawable/ic_menu_zoom"
            app:tint="@color/s2r_text_secondary"
            android:padding="6dp"
            android:scaleType="fitCenter" />
    </LinearLayout>
</LinearLayout>
