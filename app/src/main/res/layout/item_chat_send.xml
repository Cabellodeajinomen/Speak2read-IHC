<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnSpeakSend"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/speak_message"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            android:tint="@color/s2r_text_primary" />

        <ImageButton
            android:id="@+id/btnExpandSend"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/expand_message"
            android:src="@android:drawable/ic_menu_zoom"
            android:tint="@color/s2r_text_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMessageSend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        android:maxWidth="280dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_chat_send"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="@color/s2r_text_primary"
        android:textIsSelectable="true"
        android:textSize="20sp"
        android:gravity="end" />
</LinearLayout>
