<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_s2r_final"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_s2r_final"
        android:supportsRtl="true"
        android:theme="@style/Theme.Speak2Read">
        <service
            android:name=".service.SoundDetectionService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.Speak2Read">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Speak2Read" />
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.Speak2Read" />
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Speak2Read" />
        <activity
            android:name=".ConversationsActivity"
            android:exported="false"
            android:theme="@style/Theme.Speak2Read" />
        <activity
            android:name=".FavoritesActivity"
            android:exported="false"
            android:theme="@style/Theme.Speak2Read" />
        <activity
            android:name=".FullscreenTranscriptionActivity"
            android:exported="false"
            android:theme="@style/Theme.Speak2Read" />
    </application>

</manifest>